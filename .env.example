# Direct values are a local-development fallback only. Production should set
# the matching *_FILE variable instead, never both forms for the same secret.
HRAFNHOLT_CONFIG=./hrafnholt.example.yml
ENERGY_USERNAME=synthetic-energy-user
ENERGY_PASSWORD=synthetic-energy-password
MEDIA_API_KEY=synthetic-media-api-key
MEDIA_USERNAME=synthetic-media-user
MEDIA_PASSWORD=synthetic-media-password

# Production examples (leave unset when the direct form above is present):
# ENERGY_USERNAME_FILE=/run/secrets/energy_username
# ENERGY_PASSWORD_FILE=/run/secrets/energy_password
# MEDIA_API_KEY_FILE=/run/secrets/media_api_key
